# Goal runtime state (never committed — per-session ephemeral data)
.opencode/.goal-state.json
.opencode/.goal-input.txt
.opencode/.goal-state.json.tmp.*
# v0.4.1 (C-2) — corrupt-file forensic recovery. When the reader detects
# a corrupt state / handoff / chain file, it renames it to
# `<original>.corrupt.<ts>` so the user can inspect it manually. These
# files are session-local diagnostic artifacts and must never be
# committed (same trust class as the .tmp.* files above).
.opencode/.goal-state.json.corrupt.*
.opencode/.goal-handoff.json.corrupt.*
.opencode/.goal-chain.json.corrupt.*
# v0.5.0 (F-3) — goal archive (append-only JSONL, session-local runtime data)
.opencode/goal-archive.jsonl
# v0.7.0 (A1) — live session activity (append-only JSONL, session-local runtime data)
.opencode/.session-events.jsonl
.opencode/.session-events.jsonl.tmp.*

# OS files
Thumbs.db
Desktop.ini

# Node
node_modules/

# Build output (published to npm, not committed)
dist/

# npm pack artifacts
*.tgz

# Generated review bundle
REVIEW-BUNDLE.md

# Scratch workspace (one-off scripts, logs, .bak files — never committed)
scratch/

# Per-developer / per-session runtime (Mavis + OpenCode + Claude)
.mavis/
.claude/
.opencode/_install-superpowers.mjs
.opencode/tmp/
